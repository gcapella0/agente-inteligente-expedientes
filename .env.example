# --- Seguridad API ---
# CAMBIAR en producción por un valor largo, aleatorio e impredecible
JWT_SECRET_KEY=cambiar-en-produccion-clave-larga-y-compleja

# --- Email (IMAP) ---
MAIL_HOST=imap.gmail.com
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-app-password
MAIL_SSL=true
MAIL_FOLDER=INBOX
POLL_INTERVAL_SECONDS=60
SUBJECT_KEYWORD=Certificado, Diploma, Hoja de vida, Curriculum, CV, Titulo, Documentacion, Voucher de pago, Constancia, Certificado de notas
BODY_KEYWORD=Certificado, Diploma, Hoja de vida, Curriculum, CV, Titulo, Documentacion, Voucher de pago, Constancia, Certificado de notas

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=expedientes_uneg

# --- Proveedor LLM ---
# Valores: "openrouter" (producción) | "ollama" (desarrollo local sin costo)
LLM_PROVIDER=openrouter

# OpenRouter (usar si LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=tu-openrouter-api-key
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-4-scout:free,qwen/qwen3-8b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (usar si LLM_PROVIDER=ollama)
# Requiere Ollama corriendo localmente: https://ollama.com
# Modelos recomendados:
#   gemma4:e4b    → modelo de producción en servidor UNEGIA (~4B params cuantizado)
#   phi3:mini     → alternativa CPU liviana (~30-60s en i5), ~2.2 GB RAM
#   mistral       → calidad alta pero lento en CPU (>120s), no recomendado sin GPU
# Instalar: ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=400
# OLLAMA_NUM_THREADS=8  # Por defecto usa todos los núcleos disponibles

# --- Opcionales ---
# LOG_DIR=logs
# LOG_LEVEL=INFO
# INPUT_DIR=data/input
# STORAGE_DIR=data/storage
# AUDIT_RETENTION=90 days
# AUDIT_ROTATION=50 MB

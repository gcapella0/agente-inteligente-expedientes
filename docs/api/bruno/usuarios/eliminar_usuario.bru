meta {
  name: Eliminar Usuario
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/usuarios/{{usuario_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  base_url: http://localhost:8000
}

assert {
  res.status: eq 200
  res.body.message: eq "Usuario eliminado"
}

meta {
  name: Crear Usuario
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/crear-usuario
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "docente@uneg.edu.ve",
    "password": "password123",
    "nombre_completo": "Docente Ejemplo",
    "rol": "usuario"
  }
}

assert {
  res.status: eq 201
  res.body.email: isDefined
  res.body.rol: isDefined
  res.body.mensaje: isDefined
}

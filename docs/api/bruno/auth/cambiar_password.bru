meta {
  name: Cambiar Password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/cambiar-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  password_actual: admin123
  password_nuevo: nuevoPassword456
}

assert {
  res.status: eq 200
  res.body.mensaje: isDefined
}

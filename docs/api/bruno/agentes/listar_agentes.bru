meta {
  name: Listar Agentes
  type: http
  seq: 1
}

get {
  url: {{base_url}}/agentes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  base_url: http://localhost:8000

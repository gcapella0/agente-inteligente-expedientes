meta {
  name: Listar Agentes
  type: http
  seq: 1
}

get {
  url: {{base_url}}/agentes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  base_url: http://localhost:8000
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbkB1bmVnLmVkdS52ZSIsInJvbCI6ImFkbWluIiwiZXhwIjoxNzc2ODMyOTYzLCJpYXQiOjE3NzY4MDQxNjN9.fRoP1S6ZItWVMmO33uR15lNAHW3YvZidXCP0aL6_DFs
}

assert {
  res.status: eq 200
  res.body.agentes: isDefined
  res.body.pipeline_activo: isDefined
}

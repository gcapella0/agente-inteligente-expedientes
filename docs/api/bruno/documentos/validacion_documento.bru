meta {
  name: Validacion Documento
  type: http
  seq: 2
}

get {
  url: {{base_url}}/documentos/{{documento_id}}/validacion
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.validaciones: isDefined
  res.body.es_valido_para_expediente: isDefined
  res.body.validaciones.formato: isDefined
}

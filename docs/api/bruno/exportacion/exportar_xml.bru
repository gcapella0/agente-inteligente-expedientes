meta {
  name: Exportar Expediente XML
  type: http
  seq: 2
}

get {
  url: {{base_url}}/expedientes/{{cedula}}/exportar
  body: none
  auth: none
}

params:query {
  formato: xml
  incluir_documentos: true
  incluir_ocr: false
}

assert {
  res.status: eq 200
  res.headers.content-type: contains application/xml
}

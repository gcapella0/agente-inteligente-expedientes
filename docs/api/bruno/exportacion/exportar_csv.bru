meta {
  name: Exportar Expediente CSV
  type: http
  seq: 3
}

get {
  url: {{base_url}}/expedientes/{{cedula}}/exportar
  body: none
  auth: none
}

params:query {
  formato: csv
  incluir_documentos: true
  incluir_ocr: false
}

vars:pre-request {
  base_url: http://localhost:8000
  cedula: 27504759
}

assert {
  res.status: eq 200
  res.headers.content-type: contains text/csv
}

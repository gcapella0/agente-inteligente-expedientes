meta {
  name: Estadísticas Expedientes
  type: http
  seq: 1
}

get {
  url: {{base_url}}/estadisticas/expedientes
  body: none
  auth: none
}

params:query {
  agrupar_por: status
}

vars:pre-request {
  base_url: http://localhost:8000
}

assert {
  res.status: eq 200
  res.body.datos: isDefined
  res.body.total_docentes: isDefined
  res.body.agrupacion: isDefined
}

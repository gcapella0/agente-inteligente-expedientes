meta {
  name: Agregar Documento
  type: http
  seq: 1
}

post {
  url: {{base_url}}/documentos/{{cedula}}/agregar-documento
  body: json
  auth: none
}

body:json {
  {
    "tipo": "diploma_curso",
    "nombre": "Diplomado en Docencia Universitaria",
    "descripcion": "Diplomado cursado en 2024",
    "archivo_ruta": "/storage/27504759/diploma_docencia.pdf",
    "archivo_nombre_original": "diploma_docencia.pdf",
    "archivo_formato": "pdf",
    "archivo_tamano_bytes": 512000
  }
}

vars:pre-request {
  base_url: http://localhost:8000
  cedula: 27504759
}

assert {
  res.status: eq 201
  res.body.documento_id: isDefined
  res.body.docente_cedula: isDefined
  res.body.tipo: isDefined
  res.body.mensaje: isDefined
}

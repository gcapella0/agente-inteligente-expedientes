meta {
  name: Probar Conexión LLM
  type: http
  seq: 3
}

post {
  url: {{base_url}}/config/llm/probar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  base_url: http://localhost:8000
}

assert {
  res.status: eq 200
  res.body.ok: isDefined
  res.body.provider: isDefined
  res.body.mensaje: isDefined
}

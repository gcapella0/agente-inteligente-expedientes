meta {
  name: Actualizar Config LLM
  type: http
  seq: 2
}

put {
  url: {{base_url}}/config/llm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "provider": "openrouter",
    "model": "openrouter/hunter-alpha"
  }
}

vars:pre-request {
  base_url: http://localhost:8000
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.provider: isDefined
  res.body.model: isDefined
  res.body.timestamp: isDefined
}
